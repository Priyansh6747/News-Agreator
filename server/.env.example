# NewsAgreator server environment
# Copy to .env and adjust. All keys use the NEWS_ prefix.
# Lists and dicts are parsed as JSON, not comma-separated.

# --- Runtime ---------------------------------------------------------------
# demo = fixture backends + heuristic (offline), dev/prod = real backends + Laya
NEWS_APP_ENV=dev
NEWS_CORS_ORIGINS=["http://localhost:3000"]
NEWS_ENABLED_BACKENDS=["google_news","bing_news","gdelt","publisher_rss"]

# --- Decision engine -------------------------------------------------------
NEWS_DECISION_ENGINE=laya
# cuda, cpu, or leave empty for auto-detect
NEWS_LAYA_DEVICE=cpu
NEWS_LAYA_PRELOAD=false
NEWS_LAYA_DEFAULT_MODEL=english
NEWS_LAYA_MAX_LOADED=2
NEWS_LAYA_BATCH_SIZE=32
NEWS_LAYA_ASSESS_TOP=20
NEWS_PIPELINE_DEADLINE_S=90

# --- Retrieval -------------------------------------------------------------
NEWS_CANDIDATE_CAP=80
NEWS_SELECT_TOP=20
NEWS_FETCH_MAX_REPS=8
NEWS_FETCH_CONCURRENCY=4
NEWS_PER_DOMAIN_CONCURRENCY=1
NEWS_FETCH_TIMEOUT_S=12
NEWS_BODY_CAP_MB=5
NEWS_PER_DOMAIN_MIN_SPACING_S=1.0
NEWS_QUERY_CACHE_TTL_S=300
NEWS_HTTP_USER_AGENT=NewsAgreator/0.1
NEWS_HTTP_MAX_REDIRECTS=3
NEWS_GOOGLE_NEWS_MAX_QUERIES=4
NEWS_GOOGLE_NEWS_ITEM_CAP=60
NEWS_BING_NEWS_MAX_QUERIES=2
NEWS_BING_NEWS_ITEM_CAP=20
NEWS_PUBLISHER_FEED_ITEM_CAP=20
NEWS_GDELT_MAX_RECORDS=75
NEWS_GDELT_TIMEOUT_S=20
NEWS_GDELT_COOLDOWN_S=900

# --- Ranking / clustering --------------------------------------------------
NEWS_MIN_CANDIDATE_RELEVANCE=0.4
NEWS_CLUSTER_COSINE_THRESHOLD=0.615
NEWS_SYNDICATION_CONTAINMENT=0.85

# --- Enrichment ------------------------------------------------------------
NEWS_EXTRACT_MIN_WORDS=120
NEWS_INJECTION_THRESHOLD=0.7
NEWS_FACT_TEXT_CHARS=4000
NEWS_FACT_MAX_TOKENS=768
NEWS_ROBOTS_CACHE_TTL_S=86400

# --- Generator (paid API) --------------------------------------------------
# Facts and generated prose stay empty unless both key and model are set.
# Groq:
#   NEWS_GENERATOR_BASE_URL=https://api.groq.com/openai/v1
#   NEWS_GENERATOR_MODEL=qwen/qwen3.8-27b
# Gemini: the adapter detects gemini* model names and switches to
# https://generativelanguage.googleapis.com/v1beta/openai automatically.
#   NEWS_GENERATOR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   NEWS_GENERATOR_MODEL=gemini-3.5-flash-lite
NEWS_GENERATOR_BASE_URL=https://api.groq.com/openai/v1
NEWS_GENERATOR_API_KEY=
NEWS_GENERATOR_MODEL=qwen/qwen3.8-27b
NEWS_GENERATOR_TIMEOUT_S=60
NEWS_GENERATOR_MAX_TOKENS=1024
NEWS_GENERATOR_TEMPERATURE=0.2
NEWS_GENERATOR_RETRY_BASE_S=1.0
NEWS_GENERATOR_CONCURRENCY=1
